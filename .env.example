# =============================================================
#  Datos privados del Buscador de Cartas Chile.
#  Copia este archivo con el nombre ".env" y completa los valores.
#  El archivo .env NUNCA se sube a GitHub (está en .gitignore).
#  En Render, estos mismos valores se ponen en "Environment".
# =============================================================

# Token personal de CardTrader (gratis): cardtrader.com -> tu perfil -> Settings -> API
CARDTRADER_TOKEN=

# (Opcional) Correo de contacto que se agrega al User-Agent, para que las tiendas
# sepan quién las consulta. Déjalo vacío si prefieres no enviarlo.
CONTACTO=
